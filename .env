# ============================================
# TELEGRAM CREDENTIALS
# ============================================
# Dari https://my.telegram.org -> API Development Tools
API_ID=ISI_API_ID_DISINI
API_HASH=ISI_API_HASH_DISINI

# Dari @BotFather -> /newbot atau /mybots
BOT_TOKEN=ISI_BOT_TOKEN_DISINI

# ============================================
# BACKBLAZE B2 CREDENTIALS
# ============================================
# Dari B2 -> App Keys -> Add a New Application Key
B2_KEY_ID=ISI_B2_KEY_ID_DISINI
B2_APPLICATION_KEY=ISI_B2_APPLICATION_KEY_DISINI
B2_BUCKET_NAME=video-xx

# Optional: kalau sudah setup custom domain Cloudflare
# Kosongkan kalau belum ada, nanti otomatis pakai link native B2
CUSTOM_DOMAIN=

# ============================================
# GOOGLE SHEETS CREDENTIALS
# ============================================
SPREADSHEET_ID=1Qc7z0yoT3i5BNf56uD4FmR--lgcUbGro9yMAuAlFOXU

# --- PILIH SALAH SATU (bukan dua-duanya) ---

# OPSI A - Kalau jalanin bot LOKAL di laptop/PC:
# Taruh file JSON-nya di folder project, isi nama filenya di sini
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# OPSI B - Kalau deploy ke RAILWAY:
# Buka file JSON service account, copy SELURUH isinya (dari { sampai }), paste di sini jadi satu baris.
# Kosongkan GOOGLE_SERVICE_ACCOUNT_FILE di atas kalau pakai ini (biar gak bentrok).
GOOGLE_SERVICE_ACCOUNT_JSON=

# ============================================
# BOT SETTINGS (opsional, boleh dibiarin default)
# ============================================
# ID Telegram user yang boleh pakai bot (pisahkan koma kalau lebih dari satu)
# Cara cek ID sendiri: chat @userinfobot di Telegram
ALLOWED_USER_IDS=ISI_TELEGRAM_USER_ID_DISINI

# Tiap berapa jam bot otomatis cek semua link video, dan update status
# jadi "Tidak Aktif" kalau file-nya udah gak ada di B2 (misal dihapus manual).
# Boleh dikosongin, default 6 jam.
CHECK_INTERVAL_HOURS=6
